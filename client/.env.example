# Copy to .env.local for local testing with a remote API (optional).
# Production: set the same variable in Vercel → Settings → Environment Variables.

# Your Node API public URL (origin only, no trailing slash).
# This is NOT in the repo — you get it after you deploy the server (e.g. Railway).
# Example: https://zuri-production.up.railway.app
#
# Railway: Dashboard → your service → Settings → Networking → generate Public URL,
#   or open the default URL shown on the service card (https://*.up.railway.app).
# Then paste that full https origin here and redeploy Vercel so the client rebuilds.
#
# Leave empty for local dev: Vite proxies /api to http://localhost:3000
# Quick test after deploy: open https://YOUR_RAILWAY_ORIGIN/api/health — expect {"ok":true,...}
# VITE_API_URL=
