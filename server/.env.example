# Copy to .env and fill in. On Railway/Render, set these in the host’s Environment tab.
#
# Railway (monorepo): either set Service → Settings → Root Directory to `server`,
# or keep repo root and rely on repo `nixpacks.toml` (install + start run in `server/`).

PORT=3000
NODE_ENV=production

# Supabase (required for DB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# or: SUPABASE_ANON_KEY=

# Auth
JWT_SECRET=

# CORS: your Vercel site(s) exactly as the browser sends them (https, no path).
# Must match where users open the React app, or the browser blocks API calls.
# Health check: GET /api/health (use as Railway health path if you want).
# Multiple: comma-separated, no spaces (or trim handled in code)
# FRONTEND_URL=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app,https://your-app-git-main-team.vercel.app

# Optional
# FRONTEND_URL=

# Email (required in production) — all outbound mail uses Resend
# https://resend.com — verify your domain, then use e.g. no-reply@yourdomain.com
RESEND_API_KEY=re_xxx
RESEND_FROM=ZURI <no-reply@yourdomain.com>
CONTACT_EMAIL=you@domain.com
# Ticket receipt email — immediate send on pay (Paystack-like). Sweep is backup only.
# ORDER_RECEIPT_EMAIL_CONCURRENCY=8
# RESEND_MAX_RPS=8
# ORDER_RECEIPT_MAX_ATTEMPTS=12
# ORDER_RECEIPT_RETRY_BASE_MS=800
# ORDER_RECEIPT_SWEEP_INTERVAL_MS=90000
# ORDER_RECEIPT_SWEEP_LIMIT=80
# ORDER_RECEIPT_SWEEP_LOOKBACK_HOURS=336
# ORDER_RECEIPT_SWEEP_MAX_PAGES=5
# ORDER_RECEIPT_SWEEP_ENABLED=true
# ORDER_RECEIPT_LOCK_STALE_MS=600000
# ORDER_RECEIPT_NO_TICKETS_PERMANENT_AFTER=8
# ORDER_RECEIPT_AGED_ALERT_MS=300000
# ORDER_RECEIPT_SHUTDOWN_DRAIN_MS=25000
# ORDER_RECEIPT_IN_FLIGHT_SOFT_RETRIES=40
# Public storefront read cache (seconds of DB relief per guest burst)
# PUBLIC_READ_CACHE_MS=45000
# PLAN_READ_CACHE_MS=60000
# MODE_READ_CACHE_MS=60000
# Supabase resilience (post-upgrade / cold-start friendly defaults)
# SUPABASE_FETCH_TIMEOUT_MS=20000
# SUPABASE_PROBE_TIMEOUT_MS=30000
# SUPABASE_CIRCUIT_OPEN_MS=45000
# SUPABASE_CIRCUIT_FAILURES=5
# SUPABASE_HALF_OPEN_PROBES=3
# Free-tier keep-alive (one tiny businesses select every 5m in production)
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_MS=300000
KEEPALIVE_LOG=false
# Optional external ping (UptimeRobot free): GET https://your-railway.app/api/health every 5–10 min

# Zuri Tap (optional hardening knobs)
# TAP_ROOM_TTL_MS=3600000
# TAP_SESSION_TTL_MS=900000
# TAP_MAX_SENDS_PER_HOUR=40
# TAP_MAX_OPEN_PENDING=8
# TAP_MAX_STAFF_CODES=20
# TAP_CHARGE_MAX_FAILS=5
# TAP_CHARGE_LOCK_MS=900000
# TAP_LOGIN_MAX_FAILS=8
# TAP_LOGIN_LOCK_MS=900000
# TAP_JWT_TTL_SEC=2592000

# Redis (recommended for multi-instance / multiple Railway replicas)
# Shares Socket.IO rooms so a payment request on instance A reaches customers on instance B.
# Tap staff codes + sessions still work via Postgres without Redis; sockets need Redis for cross-instance emit.
# REDIS_URL=redis://default:password@host:6379

# or Upstash: UPSTASH_REDIS_URL=rediss://...

# Claude AI – get key from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# Optional:
# Optional storefront AI token cap:
# STOREFRONT_AI_MAX_TOKENS=1800

# Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@domain.com

# Africa's Talking — Zuri Assist payment-matching SMS (inbound forwards + outbound confirmations)
# Dashboard → SMS → create shortcode/alphanumeric sender; set inbound callback to:
#   https://your-API-host/api/agent/sms/inbound
# Optional query/header auth: ?secret=... or X-Zuri-At-Secret (must match AT_WEBHOOK_SECRET)
# AT_USERNAME=sandbox   # or live username
# AT_API_KEY=
# AT_SENDER_ID=ZURI     # approved sender ID / shortcode
# AT_AGENT_NUMBER=+234XXXXXXXXXX   # number businesses forward Moniepoint/OPay alerts to
# AT_WEBHOOK_SECRET=    # required in production for inbound webhook

# AI menu upload (free on all plans; tune cost/limits on Railway)
# MENU_DIGITIZE_ENABLED=true
# MENU_DIGITIZE_MAX_OUTPUT_TOKENS=2048
# MENU_DIGITIZE_HOURLY_RATE=3
# Per-plan lifetime upload caps (0 = unlimited):
# MENU_DIGITIZE_LIMIT_FREE=5
# MENU_DIGITIZE_LIMIT_STARTER=15
# MENU_DIGITIZE_LIMIT_GROWTH=40
# MENU_DIGITIZE_LIMIT_SCALE=0

# ZuriQO + AI assist daily credits (0 = unlimited). Chat / description polish share this pool.
# AI_CREDITS_DAILY_FREE=8
# AI_CREDITS_DAILY_STARTER=25
# AI_CREDITS_DAILY_GROWTH=60
# AI_CREDITS_DAILY_SCALE=0
# Storefront AI generation lifetime caps (0 = unlimited):
# STOREFRONT_AI_LIMIT_FREE=1
# STOREFRONT_AI_LIMIT_STARTER=3
# STOREFRONT_AI_LIMIT_GROWTH=8
# STOREFRONT_AI_LIMIT_SCALE=0

# Optional: public URL to a square PNG/SVG for the center of table QR codes (else orange brand plate)
# ZURI_QR_LOGO_URL=https://your-cdn.com/zuri-mark.png

# Paystack (checkout + payouts + Terminal push via Zuri Assist)
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
# Terminal: businesses link a Terminal ID in Settings; Assist pushes pending orders to the device.

# Monnify (alternative checkout + payouts — businesses choose in Payouts & billing)
# All three must be from the SAME environment (sandbox OR live):
# MONNIFY_API_KEY=MK_TEST_... or MK_PROD_...
# MONNIFY_SECRET_KEY=...          (matches the API key environment)
# MONNIFY_CONTRACT_CODE=...        (from Monnify dashboard for that environment)
# MONNIFY_WALLET_ACCOUNT_NUMBER=...  (source wallet for disbursements)
# MONNIFY_BASE_URL is optional — auto-detected from MK_TEST vs MK_PROD if omitted.
# Live:   MONNIFY_BASE_URL=https://api.monnify.com
# Sandbox: MONNIFY_BASE_URL=https://sandbox.monnify.com
# "Invalid authentication credentials" = keys, contract code, and base URL are mismatched.
# Monnify Dashboard → Developers → Webhook URLs → Transaction Completion:
#   https://your-API-host/api/payment/monnify-webhook  (Railway URL, not Vercel frontend)
# Optional: set explicitly so the dashboard URL is shown in Payouts & billing:
# MONNIFY_WEBHOOK_URL=https://zuriv5-production-e07b.up.railway.app
# PUBLIC_API_URL=https://zuriv5-production-e07b.up.railway.app
# Sandbox card test failing with "error processing the request"? Monnify cards/charge returns 500
# when the dashboard webhook URL is wrong OR card collection is not enabled on your contract.
# Use Pay with Transfer in sandbox while Monnify enables cards, or email integrations@monnify.com.
# FRONTEND_URL must be your public site (https) — used as Monnify redirectUrl after payment.
# If checkout shows "error processing request" after sandbox Success, check webhook URL returns 200.
# Paystack Dashboard → Settings → Branding (required for orange checkout buttons inside iframe):
#   Primary #ffbd59, logo https://zuriqo.com/ZURI.png
# PAYSTACK_BRAND_PRIMARY=#ffbd59
# PAYSTACK_BRAND_LABEL=ZURI
# Hosted checkout logo and colours: Paystack Dashboard → Settings → Branding (align with Zuri: cream #fffdf5, accent ~#ffbd59).
# FRONTEND_URL (above) is used so “cancel” returns guests to your Zuri pages.
# PUBLIC_API_URL can be set when your API is on a different public host; used for email QR images.
# PUBLIC_API_URL=https://api.zuriqo.com
# Optional payout fee overrides (defaults: menu 1.5%, shop 2.5% + ₦25, ticketing 4% + ₦50):
# TRANSFER_MENU_FEE_PERCENT=1.5
# TRANSFER_MENU_FEE_NAIRA=0
# TRANSFER_SHOP_FEE_PERCENT=2.5
# TRANSFER_SHOP_FEE_NAIRA=25
# TRANSFER_TICKETING_FEE_PERCENT=4
# TRANSFER_TICKETING_FEE_NAIRA=50

# Paystack split payments (commission at checkout; set false to use collect-then-transfer)
# USE_PAYSTACK_SPLIT=true

# Paystack recurring SaaS subscriptions (set false for one-time plan upgrades only)
# USE_PAYSTACK_RECURRING=true
# Optional pre-created Paystack plan codes (skip auto-create):
# PAYSTACK_PLAN_STARTER_MONTHLY=PLN_xxx
# PAYSTACK_PLAN_STARTER_YEARLY=PLN_xxx
# PAYSTACK_PLAN_GROWTH_MONTHLY=PLN_xxx
# PAYSTACK_PLAN_GROWTH_YEARLY=PLN_xxx
# PAYSTACK_PLAN_SCALE_MONTHLY=PLN_xxx
# PAYSTACK_PLAN_SCALE_YEARLY=PLN_xxx

# Renewal reminder emails (invoice.create webhook + periodic scan)
# SUBSCRIPTION_REMINDERS_ENABLED=true
# SUBSCRIPTION_REMINDER_DAYS=3
# SUBSCRIPTION_REMINDER_INTERVAL_MS=21600000

# Platform admin API (venue review, suspend, refunds) — send as X-Zuri-Admin-Key header
# ZURI_ADMIN_API_KEY=
