# Copy to .env and fill in. On Railway/Render, set these in the host’s Environment tab.
#
# Railway (monorepo): either set Service → Settings → Root Directory to `server`,
# or keep repo root and rely on repo `nixpacks.toml` (install + start run in `server/`).

PORT=3000
NODE_ENV=production

# Supabase (required for DB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# or: SUPABASE_ANON_KEY=

# Auth
JWT_SECRET=

# CORS: your Vercel site(s) exactly as the browser sends them (https, no path).
# Must match where users open the React app, or the browser blocks API calls.
# Health check: GET /api/health (use as Railway health path if you want).
# Multiple: comma-separated, no spaces (or trim handled in code)
# FRONTEND_URL=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app,https://your-app-git-main-team.vercel.app

# Optional
# FRONTEND_URL=

# Contact / Demo email delivery + welcome email after business signup
# Preferred on Railway: Resend (faster + more reliable than raw SMTP)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=ZURI <onboarding@yourdomain.com>
#
# SMTP fallback (optional)
# CONTACT_EMAIL=you@domain.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ZURI <no-reply@yourdomain.com>"

# Claude AI (Zuri Plus) – get key from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# Optional:
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: public URL to a square PNG/SVG for the center of table QR codes (else a Z mark is used)
# ZURI_QR_LOGO_URL=https://your-cdn.com/zuri-mark.png

# Paystack (checkout + payouts)
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
# Paystack Dashboard → Settings → Branding (required for orange checkout buttons inside iframe):
#   Primary #ffbd59, logo https://zuriqo.com/ZURI.png
# PAYSTACK_BRAND_PRIMARY=#ffbd59
# PAYSTACK_BRAND_LABEL=ZURI
# Hosted checkout logo and colours: Paystack Dashboard → Settings → Branding (align with Zuri: cream #fffdf5, accent ~#ffbd59).
# FRONTEND_URL (above) is used so “cancel” returns guests to your Zuri pages.
# PUBLIC_API_URL can be set when your API is on a different public host; used for email QR images.
# PUBLIC_API_URL=https://api.zuriqo.com
# Optional payout fee overrides (defaults are menu 1.5%, ticketing 4% + ₦50):
# TRANSFER_MENU_FEE_PERCENT=1.5
# TRANSFER_MENU_FEE_NAIRA=0
# TRANSFER_TICKETING_FEE_PERCENT=4
# TRANSFER_TICKETING_FEE_NAIRA=50
